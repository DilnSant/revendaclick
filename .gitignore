.claude/settings.local.json

!memory/
!memory/*.md

# Backups locais de reorganização IA
_backup_*/

# Ajuste fino da governança IA
# Rastrear somente os arquivos oficiais da estrutura mínima

.claude/*
!.claude/
!.claude/01_CONTEXTO.md
!.claude/02_AUTORIZACOES.md
!.claude/03_FLUXO_TRABALHO.md
!.claude/04_VALIDACAO.md

# Comandos e agentes de governança (ver D35 e FC057 — um diretório excluído
# pelo pai não pode ser reincluído só pelos arquivos: liberar o diretório antes)
!.claude/commands/
!.claude/commands/*.md
!.claude/agents/
!.claude/agents/*.md

memory/*
!memory/
!memory/00_REGRAS_DE_USO_IA.md
!memory/01_PREFERENCIAS_USUARIO.md
!memory/02_LICOES_APRENDIDAS.md

_backup_*/

