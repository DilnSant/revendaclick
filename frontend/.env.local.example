# ─── Supabase — public (safe to expose to browser) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR_ANON_KEY]

# ─── Supabase — secret (server-only, NEVER expose to browser) ─────────────────
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY]

# ─── Go Backend ───────────────────────────────────────────────────────────────
# Public fallback — used by client components and server actions
NEXT_PUBLIC_API_URL=https://api.revendaclick.com.br

# Server-only override for faster internal networking
# Vercel: set to https://api.revendaclick.com.br
# Docker: set to http://backend:8080
INTERNAL_API_URL=https://api.revendaclick.com.br

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.revendaclick.com.br

# ─── Observability (optional) ─────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://...
