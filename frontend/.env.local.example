# ─── Supabase — public (safe to expose to browser) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR_ANON_KEY]

# ─── Supabase — secret (server-only, NEVER expose to browser) ─────────────────
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY]

# ─── Go Backend ───────────────────────────────────────────────────────────────
# Public fallback — used by client components and server actions
NEXT_PUBLIC_API_URL=https://api.revendaclick.com.br

# Server-only override for faster internal networking
# Vercel: set to https://api.revendaclick.com.br
# Docker: set to http://backend:8080
INTERNAL_API_URL=https://api.revendaclick.com.br

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.revendaclick.com.br

# ─── Observability / BetterStack ──────────────────────────────────────────────
# Create a source at betterstack.com → Logs → Sources → new source.
# Token and ingesting URL are both shown in the source settings.
# NEVER use NEXT_PUBLIC_ prefix here — these are server-only secrets.
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_URL=https://in.logs.betterstack.com

# ─── Analytics — Google Analytics 4 ──────────────────────────────────────────
# GA4 Measurement ID (ex: G-XXXXXXXXXX). Deixar em branco para desabilitar.
NEXT_PUBLIC_GA_ID=

# ─── Analytics — Meta (Facebook) Pixel ───────────────────────────────────────
# Pixel ID numérico do Gerenciador de Eventos da Meta.
# Obter em: business.facebook.com → Events Manager → Pixels
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Analytics — TikTok Pixel ────────────────────────────────────────────────
# Pixel ID do TikTok Ads Manager.
# Obter em: ads.tiktok.com → Assets → Events → Pixel
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─── Landing Page ─────────────────────────────────────────────────────────────
# Número de WhatsApp da equipe de vendas (somente dígitos, com DDI).
# Ex: 5511999999999 → WhatsApp Brasil (55) + DDD (11) + número
NEXT_PUBLIC_WA_NUMBER=5511999999999

# ID do vídeo de demonstração no YouTube (ex: dQw4w9WgXcQ).
# Se não configurado, exibe placeholder elegante no modal de vídeo.
NEXT_PUBLIC_DEMO_VIDEO_ID=

# ─── Webhook de leads (opcional) ──────────────────────────────────────────────
# URL para reenvio de leads em tempo real (N8N, Make, WhatsApp API, etc.).
# Se não configurado, o lead é apenas salvo no Supabase.
# O webhook recebe um POST com: name, phone, vehicles_count, city, state,
# source, utm_source, utm_medium, utm_campaign, utm_content, created_at.
WEBHOOK_LEADS_URL=
