# =============================================================================
# RevendaClick Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Use Session Pooler (port 5432), NOT Transaction pooler
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=your_jwt_secret_from_supabase_settings
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,https://app.revendaclick.com.br,https://revendaclick.com.br,https://www.revendaclick.com.br

# ─── Evolution API (WhatsApp) ─────────────────────────────────────────────────
# Internal Docker network URL in production: http://evolution:8080
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=your_evolution_api_key

# ─── OpenRouter (AI) ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Asaas (Billing) ─────────────────────────────────────────────────────────
ASAAS_API_KEY=aact_your_asaas_key
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=your_asaas_webhook_access_token

# ─── Observability ────────────────────────────────────────────────────────────
# Bearer token required to scrape /metrics. Generate with: openssl rand -hex 32
METRICS_TOKEN=your_secure_metrics_token

# ─── BetterStack (Logs) ───────────────────────────────────────────────────────
# Source token from BetterStack → Sources → your source → HTTP source token.
# When set, all INFO+ logs are shipped to BetterStack in addition to stdout.
BETTER_STACK_SOURCE_TOKEN=

