# =============================================================================
# RevendaClick — Root .env (loaded by docker-compose)
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Frontend public URLs (baked into Next.js bundle at build time) ───────────
# Production:
NEXT_PUBLIC_API_URL=https://api.revendaclick.com.br
NEXT_PUBLIC_APP_URL=https://revendaclick.com.br

# ─── Docker image registry (used by docker-compose.prod.yml) ──────────────────
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USER/revendaclick-backend
FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_USER/revendaclick-frontend
IMAGE_TAG=latest

# ─── Evolution API (WhatsApp) ─────────────────────────────────────────────────
EVOLUTION_API_KEY=your_evolution_api_key_here

# Evolution uses its own DB connection (can be the same Supabase project):
EVOLUTION_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
