# =============================================================================
# RevendaClick — Root .env (carregado pelo docker-compose)
# Copie para .env e preencha os valores reais. NUNCA commite .env no git.
# =============================================================================

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/SEU_PROJECT_REF/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh...sua_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJh...sua_service_role_key
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# ─── URLs públicas (baked no bundle Next.js em build time) ───────────────────
NEXT_PUBLIC_API_URL=https://api.revendaclick.com.br
NEXT_PUBLIC_APP_URL=https://revendaclick.com.br

# URL interna Docker (Server Components → Backend sem passar pelo Nginx)
INTERNAL_API_URL=http://backend:8080

# ─── Banco de dados ───────────────────────────────────────────────────────────
# Backend Go: usa PgBouncer transaction pooler (porta 6543) — sem advisory locks
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Evolution/Prisma: usa session pooler (porta 5432) — Prisma precisa de advisory locks
# CRÍTICO: sempre porta 5432, nunca 6543 (Evolution não inicia com 6543)
EVOLUTION_DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Docker image registry ────────────────────────────────────────────────────
# IMPORTANTE: GHCR exige lowercase — dilnsant não DilnSant
BACKEND_IMAGE=ghcr.io/dilnsant/revendaclick-backend
FRONTEND_IMAGE=ghcr.io/dilnsant/revendaclick-frontend
IMAGE_TAG=latest

# ─── Evolution API (WhatsApp) ─────────────────────────────────────────────────
EVOLUTION_API_KEY=sua_evolution_api_key

# ─── Asaas (Billing) ──────────────────────────────────────────────────────────
# CRÍTICO: chaves com $ literal devem usar $$ no .env (Docker Compose double-interpolation)
# Exemplo: se a chave começa com $aact_prod_... → escreva $$aact_prod_...
ASAAS_API_KEY=$$aact_prod_sua_chave_aqui
ASAAS_ENV=production
# Token deve ser idêntico ao configurado em: asaas.com → Integrações → Webhooks
ASAAS_WEBHOOK_TOKEN=whsec_seu_token_aqui

# ─── OpenRouter (IA) ──────────────────────────────────────────────────────────
# Obter em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-sua_chave_aqui
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Resend (e-mail de aviso de vencimento) ────────────────────────────────────
RESEND_API_KEY=re_sua_chave_aqui
RESEND_FROM_EMAIL=cobranca@revendaclick.com.br

# ─── Observabilidade ──────────────────────────────────────────────────────────
# Gerar: openssl rand -hex 32
# Necessário para acessar /metrics (sem isso o endpoint retorna 403)
METRICS_TOKEN=seu_token_seguro_aqui

# BetterStack: Dashboard → Sources → sua source → "Source Token"
BETTER_STACK_SOURCE_TOKEN=sua_source_token_aqui

# ─── Analytics (opcional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
