# ─────────────────────────────────────────────────────────────────────────────
# Root .env — loaded automatically by docker-compose from the project root.
# Copy to .env and fill in real values.  DO NOT commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase — Frontend project ───────────────────────────────────────────────
# Baked into the Next.js bundle at build time (NEXT_PUBLIC_* vars).
# Get from: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[frontend-project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase — Service role (server-side Next.js only) ────────────────────────
# Must match the SAME project as NEXT_PUBLIC_SUPABASE_URL above.
# Get from: Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Frontend public URLs (baked at build time by Next.js) ────────────────────
NEXT_PUBLIC_API_URL=https://revendaclick.app
NEXT_PUBLIC_APP_URL=https://revendaclick.app
