# ── Backend Go ────────────────────────────────────────────────────────────────
BACKEND_IMAGE=ghcr.io/dilnsant/revendaclick-backend
IMAGE_TAG=latest

# Supabase session pooler (port 5432) — NOT transaction pooler (6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://[ref].supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Evolution API (WhatsApp) ───────────────────────────────────────────────────
EVOLUTION_API_KEY=your-evolution-api-key
# CRITICAL: session pooler port 5432 required for Evolution Prisma migrations
EVOLUTION_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ── OpenRouter AI ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Asaas Billing ─────────────────────────────────────────────────────────────
ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENV=production

# ── GHCR credentials (used by deploy.sh) ─────────────────────────────────────
GHCR_USER=dilnsant
GHCR_TOKEN=ghp_your_github_token_with_packages_read

# ── Backup S3 (optional — leave blank to backup locally only) ─────────────────
# Backups are always saved locally to /opt/revendaclick/backups/ (7-day retention)
# Set BACKUP_S3_BUCKET to also upload to S3 after each local backup
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
